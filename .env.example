# === Supabase (Required) ===
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# === AI Trip Planning (server-side via Edge Function) ===
# NOT used client-side. Set as Supabase secret: supabase secrets set OPENAI_API_KEY=sk-...
# Smart fallback works without it.

# === Payment Gateway (any PG — set checkout URLs) ===
# Works with: Razorpay, Stripe, Cashfree, LemonSqueezy, PayU, PhonePe
# Create payment/checkout links in your PG dashboard and paste URLs here

# Consumer plans
VITE_PRO_CHECKOUT_URL=""
VITE_PREMIUM_CHECKOUT_URL=""

# Agency plans (optional)
VITE_STARTER_CHECKOUT_URL=""
VITE_GROWTH_CHECKOUT_URL=""
VITE_ENTERPRISE_CHECKOUT_URL=""

# Legacy Stripe (backward compat)
VITE_STRIPE_PRO_LINK=""
VITE_STRIPE_PREMIUM_LINK=""

# Cashfree (optional — for programmatic checkout)
VITE_CASHFREE_APP_ID=""
VITE_CASHFREE_MODE="sandbox"

# === Ads & Affiliates ===
VITE_ADSENSE_PUB_ID=""
VITE_BOOKING_AFFILIATE_ID=""
VITE_SKYSCANNER_ASSOCIATE_ID=""
VITE_AGODA_CID=""
VITE_BMC_URL="https://www.buymeacoffee.com/tripgenie"
